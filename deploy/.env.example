# คัดลอกไฟล์นี้เป็น .env (cp .env.example .env) แล้วกรอกรหัสผ่านให้ครบก่อนสั่ง docker compose up
# สร้างรหัสผ่านด้วยคำสั่ง:  openssl rand -hex 24
# ใช้เฉพาะตัวอักษร a-z และตัวเลข เพราะรหัสถูกนำไปต่อใน DATABASE_URL (ห้ามมี @ : / + #)

# --- ฐานข้อมูล MariaDB (ไม่เปิดพอร์ตออกนอกเครื่อง) ---
DB_ROOT_PASSWORD=
DB_NAME=allar_db
DB_USER=allar_user
DB_PASSWORD=

# --- เว็บ ---
# เวอร์ชันของ image (ใช้ตั้งชื่อ tag เช่น 1.0.0)
APP_VERSION=latest
# 127.0.0.1 = รับเฉพาะในเครื่อง ให้ reverse proxy (nginx/IIS) ส่งต่อมา
# ตั้งเป็น 0.0.0.0 เฉพาะเมื่อไม่มี reverse proxy และต้องการเปิดพอร์ตตรง
WEB_BIND=127.0.0.1
WEB_PORT=3000
# true = เชื่อ IP จาก header X-Forwarded-For ที่ reverse proxy ส่งมา (ใช้ล็อกการล็อกอินผิดตาม IP)
# ตั้ง false ถ้าเปิดเว็บตรงโดยไม่มี reverse proxy
TRUST_PROXY=true
# ที่อยู่เว็บจริงแบบเต็ม เช่น https://lac.snru.ac.th (ไม่ต้องมี / ปิดท้าย) ใช้ทำลิงก์ใน sitemap.xml และ robots.txt
# เว้นว่างได้ เว็บจะใช้ชื่อโดเมนจากคำขอที่ reverse proxy ส่งต่อมา (Host / X-Forwarded-Host)
SITE_URL=

# --- สำรองข้อมูลอัตโนมัติ (เวลาไทย Asia/Bangkok) ---
# เวลาที่สำรองทุกวัน รูปแบบ HH:MM
BACKUP_TIME=02:00
# ลบไฟล์สำรองที่เก่ากว่ากี่วัน
BACKUP_KEEP_DAYS=30

# --- phpMyAdmin (เปิดเฉพาะเมื่อสั่ง --profile tools และเข้าได้จาก 127.0.0.1 เท่านั้น) ---
PMA_PORT=8080
